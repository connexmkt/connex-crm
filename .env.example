# Supabase do próprio connex-crm (autenticação, dados do CRM)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres do próprio connex-crm, usado exclusivamente pelo Prisma para a
# tabela `insights_user_provisioning_requests` (auditoria/idempotência do
# provisionamento de usuários do Connex Insights). Ver
# specs/002-provisionamento-usuarios-insights/research.md § D1.
DATABASE_URL=
DIRECT_URL=

# Acesso administrativo (Service Role) ao projeto Supabase do Connex
# Insights, usado exclusivamente em contexto de servidor (Route Handlers)
# para ler indicadores/tenants/usuários e provisionar novos acessos. NUNCA
# expor com o prefixo NEXT_PUBLIC_ (uso server-only).
SUPABASE_INSIGHTS_URL=
SUPABASE_INSIGHTS_SERVICE_ROLE_KEY=
