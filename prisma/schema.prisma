// Prisma schema do connex-crm.
//
// Sem models no momento. O acesso a dados do CRM é feito via
// `@supabase/supabase-js`. Este schema permanece configurado para
// eventual uso futuro do Prisma.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
